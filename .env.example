# Copy to .env and fill in real values. Never commit .env (gitignored).
#
# IMPORTANT: Quote values that contain # or ! — otherwise # starts a comment.

# AudioMuse (alchemy anchors / similarity programming)
AUDIOMUSE_URL=http://192.168.1.10:8387
AUDIOMUSE_API_TOKEN="your-audiomuse-api-token"

# Navidrome (audio stream source — resolves item_id to playable URLs)
NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_USER=your-user
NAVIDROME_PASSWORD="your-password"

# Icecast — internal Docker name/port (Liquidsoap → Icecast)
ICECAST_PORT=8000
# Port listeners use when not behind a same-host reverse proxy (LAN / published :8000)
ICECAST_PUBLIC_PORT=8000
# Optional fallback when no browser request is available (admin API, etc.)
ICECAST_PUBLIC_HOST=localhost
ICECAST_PUBLIC_SCHEME=
ICECAST_SOURCE_PASSWORD=hackme
# ICECAST_MAX_CLIENTS/ICECAST_MAX_SOURCES only apply to docker-compose.unraid.yml.
# docker-compose.yml and docker-compose.traefik.yml instead mount a shared
# icecast.xml that the backend's admin-saved broadcast settings (max
# listeners, source slots) write directly -- these two vars are ignored
# there and setting them has no effect.
ICECAST_MAX_CLIENTS=100
ICECAST_MAX_SOURCES=20

# Backend — host port published to Docker (container always listens on 8080 inside)
# Unraid direct compose: 9752 | local docker-compose.yml: 8080 | Traefik compose: 9246
BACKEND_PORT=9752
LIQUIDSOAP_CALLBACK_SECRET="change-me-to-a-random-secret"
QUEUE_REFRESH_INTERVAL_SEC=30

# Backend logging (persistent, size-capped file under DATA_DIR/logs/)
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# Admin (required before exposing the site publicly)
ADMIN_USERNAME=admin
ADMIN_PASSWORD="choose-a-long-random-password"

# Restart Icecast from admin (needs Docker socket mounted into backend — enabled in docker-compose.yml)
ICECAST_DOCKER_RESTART=true
# Optional: set if you run multiple compose projects with an icecast service
# DOCKER_COMPOSE_PROJECT=audiomuse-radio
# When behind a reverse proxy that sets X-Forwarded-For / X-Real-IP:
# TRUST_PROXY_HEADERS=true
# RESTRICT_INTERNAL_ROUTES=true

# Traefik (docker-compose.traefik.yml)
ALCHEMYFM_HOST=radio.example.com
# Labels match mmagtech Traefik: proxy network, websecure, cloudflare, noindex+crowdsec

# Optional: music knowledge enrichment (OFF by default — no UI changes when false)
KNOWLEDGE_FEATURE=false
KNOWLEDGE_DATABASE_URL=sqlite:////data/knowledge.db
# Search uses MusicBrainz + Wikipedia + DuckDuckGo by default (no keys).
# Optional SearXNG fallback when the free APIs return nothing:
SEARXNG_URL=
OLLAMA_URL=
OLLAMA_MODEL=
